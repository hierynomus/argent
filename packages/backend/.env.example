# Local development settings. Copy this file to `.env.development` (which is not committed):
#
#   cp packages/backend/.env.example packages/backend/.env.development
#
# `bun run dev:backend` loads it.

# JWT validation is skipped and a static dev user is injected.
AUTH_MODE=fake
PORT=3000
CORS_ORIGIN=http://localhost:5173
AUTHENTIK_ADMIN_GROUP=finance-admin
AUTHENTIK_IMPORT_GROUP=finance-import

# The database. With DATABASE_URL unset, development uses an embedded PGlite database that keeps its data in
# packages/backend/.data/pglite, so what you enter survives restarts and hot reloads.
#   bun run db:reset                 throw the development data away and start empty
#   PGLITE_DATA_DIR=/some/dir        keep the data somewhere else
#   DATABASE_URL=memory              a throw-away in-memory database (what the tests use)
#   DATABASE_URL=postgresql://...    a real Postgres server
# DATABASE_URL=
# PGLITE_DATA_DIR=

# Optional: a free CoinGecko "demo" API key (the key-less API is heavily rate limited)
# COINGECKO_API_KEY=
