{
  "name": "@argent/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot --env-file=.env.development src/index.ts",
    "start": "bun run src/index.ts",
    "start:local": "bun run src/standalone/dev.ts",
    "build:standalone": "bun run scripts/build-standalone.ts",
    "db:generate": "drizzle-kit generate",
    "db:reset": "rm -rf .data",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:check": "bun run scripts/db-check.ts",
    "test": "bun test",
    "test:tz": "bun run scripts/test-timezones.ts",
    "typecheck": "bunx tsc --noEmit -p ."
  },
  "dependencies": {
    "@argent/shared": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.19",
    "jose": "^5.9.0",
    "postgres": "^3.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.7.0"
  }
}
